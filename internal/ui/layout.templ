package ui

import (
	"cmp"
	"fmt"
)

// LayoutProps configures the page shell: the <html>/<head> boilerplate, the
// NavBar, an optional flash notice, and a <main> the caller's content renders
// into. Ported from assets/templates/layout.html — the CSRF token still rides
// on body's hx-headers so every htmx mutation carries X-CSRF-Token.
type LayoutProps struct {
	Title string
	// Description overrides the default meta description; empty renders
	// the site's own pitch, unchanged from before this field existed.
	Description string
	CSRFToken   string
	LoggedIn    bool
	Flash       string
	// Theme is a signed-in user's explicit preference: "system", "light",
	// or "dark". It lands on <html data-theme="..."> in this same response
	// — not applied by client-side JS after paint — so there's no flash of
	// the wrong theme. Left empty for a signed-out visitor, which renders
	// <html> with no data-theme attribute at all so input.css's
	// prefers-color-scheme media query is the only thing deciding the
	// palette, exactly as it did before this preference existed.
	Theme string
	// OpenGraph gives a page its own social preview — a shared tier list's
	// og:title and og:description differ from the site default, and
	// matter more here than almost anywhere else in the app, since a
	// shared link is the app's best organic acquisition surface. Nil
	// renders no og: tags at all.
	OpenGraph *OpenGraphProps
}

// OpenGraphProps configures a page's Open Graph tags, read by link
// unfurlers (Slack, Discord, iMessage, social platforms) when its URL gets
// pasted somewhere.
type OpenGraphProps struct {
	Title       string
	Description string
	// Type is the og:type value, e.g. "website"; empty defaults to "website".
	Type string
	URL  string
}

const defaultDescription = "Drag anything into tiers. Start ranking instantly, sign in only when you want to keep it."

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme={ props.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ cmp.Or(props.Title, "Rank Anything") }</title>
			<meta
				name="description"
				content={ cmp.Or(props.Description, defaultDescription) }
			/>
			if props.OpenGraph != nil {
				<meta property="og:title" content={ cmp.Or(props.OpenGraph.Title, cmp.Or(props.Title, "Rank Anything")) }/>
				<meta property="og:description" content={ cmp.Or(props.OpenGraph.Description, cmp.Or(props.Description, defaultDescription)) }/>
				<meta property="og:type" content={ cmp.Or(props.OpenGraph.Type, "website") }/>
				if props.OpenGraph.URL != "" {
					<meta property="og:url" content={ props.OpenGraph.URL }/>
				}
			}
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body
			class="min-h-full bg-background text-text antialiased"
			hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, props.CSRFToken) }
		>
			@NavBar(NavBarProps{LoggedIn: props.LoggedIn})
			if props.Flash != "" {
				<div class="mx-auto mt-4 max-w-6xl px-6">
					@Notice(NoticeProps{Variant: NoticeSuccess, Dismissable: true, ID: "flash"}) {
						{ props.Flash }
					}
				</div>
			}
			<main class="mx-auto max-w-6xl px-6 py-4">
				{ children... }
			</main>
		</body>
	</html>
}
