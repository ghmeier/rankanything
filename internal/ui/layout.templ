package ui

import (
	"cmp"
	"fmt"
)

// LayoutProps configures the page shell. The CSRF token rides on body's
// hx-headers, so every htmx mutation carries X-CSRF-Token.
type LayoutProps struct {
	Title string
	// Empty renders the site's own pitch.
	Description string
	CSRFToken   string
	LoggedIn    bool
	Flash       string
	// Theme lands on <html data-theme> in this same response rather than
	// being applied by JS after paint, so there's no flash of the wrong
	// theme. Empty omits the attribute, leaving prefers-color-scheme to
	// decide.
	Theme string
	// OpenGraph gives a shared tier list its own social preview. Nil renders
	// no og: tags.
	OpenGraph *OpenGraphProps
	// Wide widens the content column for the pages that are a board rather
	// than prose. Text pages stay narrow enough to stay readable.
	Wide bool
}

// OpenGraphProps configures the tags link unfurlers read.
type OpenGraphProps struct {
	Title       string
	Description string
	// Type is the og:type value, e.g. "website"; empty defaults to "website".
	Type string
	URL  string
}

const defaultDescription = "Drag anything into tiers. Start ranking instantly, sign in only when you want to keep it."

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme={ props.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ cmp.Or(props.Title, "Rank Anything") }</title>
			<meta
				name="description"
				content={ cmp.Or(props.Description, defaultDescription) }
			/>
			if props.OpenGraph != nil {
				<meta property="og:title" content={ cmp.Or(props.OpenGraph.Title, cmp.Or(props.Title, "Rank Anything")) }/>
				<meta property="og:description" content={ cmp.Or(props.OpenGraph.Description, cmp.Or(props.Description, defaultDescription)) }/>
				<meta property="og:type" content={ cmp.Or(props.OpenGraph.Type, "website") }/>
				if props.OpenGraph.URL != "" {
					<meta property="og:url" content={ props.OpenGraph.URL }/>
				}
			}
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body
			class="min-h-full bg-background text-text antialiased"
			hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, props.CSRFToken) }
		>
			@SideNav(SideNavProps{LoggedIn: props.LoggedIn})
			// The padding clears the nav rail, which is fixed: on md and up it
			// runs down the left edge, below that it sits across the bottom.
			<div class="pb-16 md:pb-0 md:pl-14">
				if props.Flash != "" {
					<div class={ layoutContainerClass(props.Wide), "mt-4" }>
						@Notice(NoticeProps{Variant: NoticeSuccess, Dismissable: true, ID: "flash"}) {
							{ props.Flash }
						}
					</div>
				}
				<main class={ layoutContainerClass(props.Wide), "py-4" }>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

func layoutContainerClass(wide bool) string {
	if wide {
		return "mx-auto w-full max-w-[96rem] px-6"
	}
	return "mx-auto w-full max-w-6xl px-6"
}
