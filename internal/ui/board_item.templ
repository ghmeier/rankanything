package ui

import (
	"fmt"
	"strconv"
)

// ItemCardProps renders one ranking item, in the tray or in a tier. It
// carries RankingUUID rather than relying on an ancestor for it because a
// mutation handler renders this component standalone as an htmx swap
// target, with no surrounding page.
type ItemCardProps struct {
	RankingUUID      string
	VersionShortUUID string
	ItemID           int64
	Title            string
	ImageURL         string
	// Editable is false while viewing a published version: a published
	// version is immutable, so the card is neither draggable nor removable.
	Editable bool
}

templ ItemCard(props ItemCardProps) {
	<article
		class="item-card group flex h-fit w-40 cursor-grab items-center gap-2 rounded-md border border-border bg-surface p-2 text-sm shadow-sm"
		id={ fmt.Sprintf("ranking-item-%d", props.ItemID) }
		data-item-id={ fmt.Sprintf("%d", props.ItemID) }
		draggable={ strconv.FormatBool(props.Editable) }
	>
		if props.ImageURL != "" {
			<img
				src={ props.ImageURL }
				alt={ props.Title }
				loading="lazy"
				class="h-10 w-10 rounded object-cover"
			/>
		}
		<div class="min-w-0 flex-1">
			<p class="truncate font-medium text-text">{ props.Title }</p>
		</div>
		if props.Editable {
			<button
				hx-delete={ fmt.Sprintf("/r/%s/v/%s/items/%d", props.RankingUUID, props.VersionShortUUID, props.ItemID) }
				hx-target={ fmt.Sprintf("#ranking-item-%d", props.ItemID) }
				hx-swap="outerHTML"
				aria-label={ "Remove " + props.Title }
				class="text-slate-500 opacity-0 transition group-hover:opacity-100 hover:text-rose-400"
			>
				&times;
			</button>
		}
	</article>
}

// ItemTrayProps renders the unranked item tray: its add-item form and every
// item that isn't yet placed in a tier.
type ItemTrayProps struct {
	RankingUUID      string
	VersionShortUUID string
	Unassigned       []ItemCardProps
	// Editable is false while viewing a published version: the add-item
	// form is left unrendered rather than merely disabled.
	Editable bool
}

templ ItemTray(props ItemTrayProps) {
	<section class="rounded-lg border border-dashed border-border bg-surface-muted p-4">
		<div class="mb-3 flex items-center justify-between">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-text-muted">
				Unranked items
			</h2>
			if props.Editable {
				<form
					class="flex gap-2"
					hx-post={ fmt.Sprintf("/r/%s/v/%s/items", props.RankingUUID, props.VersionShortUUID) }
					hx-target="#tray-items"
					hx-swap="beforeend"
					hx-on::after-request="this.reset()"
				>
					<input
						name="label"
						required
						placeholder="Add an item"
						aria-label="Item label"
						class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm outline-none focus:bg-surface-hover"
					/>
					<input
						name="image_url"
						placeholder="Image URL (optional)"
						aria-label="Item image URL"
						class="w-48 rounded-md border border-border bg-surface px-3 py-1.5 text-sm outline-none focus:bg-surface-hover"
					/>
					<button class="rounded-md border border-border bg-secondary px-3 py-1.5 text-sm text-background hover:bg-secondary-hover">
						Add
					</button>
				</form>
			}
		</div>
		@TrayItems(TrayItemsProps{RankingUUID: props.RankingUUID, Items: props.Unassigned})
	</section>
}

// TrayItemsProps renders the unranked tray's #tray-items drop zone —
// embedded normally in ItemTray, and rendered standalone (with OOB set) to
// refresh the tray out-of-band alongside a tier deletion, which returns the
// deleted tier's items to it.
type TrayItemsProps struct {
	RankingUUID string
	Items       []ItemCardProps
	OOB         bool
}

templ TrayItems(props TrayItemsProps) {
	<div
		id="tray-items"
		data-tier-id=""
		class="tier-dropzone flex min-h-20 flex-wrap gap-2"
		if props.OOB {
			hx-swap-oob="true"
		}
	>
		for _, item := range props.Items {
			@ItemCard(item)
		}
	</div>
}
