package ui

// Icons paint with fill="currentColor", so they pick up whatever text color
// their variant sets, hover included.
templ EditIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" class="fill-current">
		<path d="M0 0h24v24H0z" fill="none"></path>
		<path
			fill="currentColor"
			d="M5 21h14c1.1 0 2-.9 2-2v-8h-2v8H5V5h8V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2"
		></path>
		<path
			fill="currentColor"
			d="M7 14v2c0 .55.45 1 1 1h2c.27 0 .52-.11.71-.29l7.65-7.65l-3.41-3.41L7.3 13.3a1 1 0 0 0-.29.71Zm13.71-7.29a.996.996 0 0 0 0-1.41l-2-2a.996.996 0 0 0-1.41 0l-1.65 1.65l3.41 3.41z"
		></path>
	</svg>
}

