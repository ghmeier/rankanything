package ui

// AccountProps configures AccountPage — the signed-in settings surface,
// currently just the theme preference. Email is display-only; there's no
// form field for it yet.
type AccountProps struct {
	CSRFToken string
	LoggedIn  bool
	Flash     string
	Email     string
	Theme     string
}

templ AccountPage(props AccountProps) {
	@Layout(LayoutProps{Title: "Account", CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash, Theme: props.Theme}) {
		<div class="mx-auto max-w-sm space-y-8">
			<div>
				<h1 class="text-2xl font-bold tracking-tight">Account</h1>
				<p class="mt-1 text-sm text-text-muted">{ props.Email }</p>
			</div>
			@ThemeSettings(props.Theme)
		</div>
	}
}

// ThemeSettings is its own component (rather than inline in AccountPage) so
// the POST /account/theme handler can re-render just this fragment as the
// htmx swap target.
templ ThemeSettings(theme string) {
	<form
		id="theme-settings"
		class="space-y-2"
		hx-post="/account/theme"
		hx-target="#theme-settings"
		hx-swap="outerHTML"
		hx-trigger="change"
	>
		<span class="block text-xs uppercase tracking-wide text-text-muted">Theme</span>
		<div class="flex gap-4 text-sm">
			@themeOption(theme, "system", "System")
			@themeOption(theme, "light", "Light")
			@themeOption(theme, "dark", "Dark")
		</div>
	</form>
}

templ themeOption(current, value, label string) {
	<label class="inline-flex cursor-pointer items-center gap-2">
		<input type="radio" name="theme" value={ value } checked?={ current == value }/>
		<span class="text-text">{ label }</span>
	</label>
}
