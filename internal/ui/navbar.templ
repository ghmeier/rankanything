package ui

// NavBarProps configures NavBar. LoggedIn switches between the signed-out
// (sign in / create account) and signed-in (your rankings / sign out) nav.
type NavBarProps struct {
	LoggedIn bool
}

templ NavBar(props NavBarProps) {
	<header class="border-b border-border">
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
			<a href="/" class="text-lg font-semibold tracking-tight">
				<span class="text-text-muted">rank</span>anything
			</a>
			<nav class="flex items-center gap-4 text-sm">
				if props.LoggedIn {
					<a href="/me" class="text-text-muted hover:text-text-muted-hover">Your rankings</a>
					<a href="/account" class="text-text-muted hover:text-text-muted-hover">Account</a>
					<button class="text-text-muted hover:text-text-muted-hover" type="button" hx-post="/logout">
						Sign out
					</button>
				} else {
					<a href="/login" class="text-text-muted hover:text-text-muted-hover">Sign in</a>
					<a href="/register" class={ ButtonClass(ButtonPrimary) }>Create account</a>
				}
			</nav>
		</div>
	</header>
}
