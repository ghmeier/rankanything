package ui

type TooltipPlacement string

const (
	TooltipTop    TooltipPlacement = "top"
	TooltipRight  TooltipPlacement = "right"
	TooltipLeft   TooltipPlacement = "left"
	TooltipBottom TooltipPlacement = "bottom"
)

type TooltipProps struct {
	Placement TooltipPlacement
	Width     string
}

templ Tooltip(props TooltipProps) {
	<div role="tooltip" class={ tooltipPanelClass(props.Placement), props.Width }>
		{ children... }
	</div>
}

func tooltipPanelClass(placement TooltipPlacement) string {
	switch placement {
	case TooltipRight:
		return tooltipBaseClass + " left-full top-1/2 ml-2 -translate-y-1/2"
	case TooltipLeft:
		return tooltipBaseClass + " right-full top-1/2 mr-2 -translate-y-1/2"
	case TooltipTop:
		return tooltipBaseClass + " bottom-full left-1/2 mb-2 -translate-x-1/2"
	default:
		return tooltipBaseClass + " top-full left-1/2 mt-2 -translate-x-1/2"
	}
}

const tooltipBaseClass = "pointer-events-none invisible absolute z-10 rounded bg-surface p-2 text-xs text-text opacity-0 shadow-md transition-opacity group-hover:visible group-hover:opacity-100"
