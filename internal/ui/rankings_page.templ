package ui

// RankingsIndexProps configures RankingsIndexPage. VerificationNotice renders
// above the heading; nil renders nothing.
type RankingsIndexProps struct {
	CSRFToken          string
	LoggedIn           bool
	Flash              string
	Theme              string
	VerificationNotice templ.Component
	Rankings           []RankingsIndexCard
}

// RankingsIndexCard names both versions when a draft sits on a publish, so a
// reader can tell the live version is stale. Either string is empty on its
// own: a never-published ranking has no PublishedAt, and one with nothing
// unpublished has no DraftURL.
type RankingsIndexCard struct {
	URL         string
	Name        string
	PublishedAt string
	DraftURL    string
}

templ RankingsIndexPage(props RankingsIndexProps) {
	@Layout(LayoutProps{Title: "Your rankings", CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash, Theme: props.Theme}) {
		<div class="space-y-6">
			if props.VerificationNotice != nil {
				@props.VerificationNotice
			}
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Your rankings</h1>
				@Button(ButtonProps{Variant: ButtonPrimary, Attrs: templ.Attributes{"hx-post": "/new"}}) {
					Create ranking
				}
			</div>
			if len(props.Rankings) == 0 {
				@rankingsIndexEmptyState()
			} else {
				@rankingsIndexList(props.Rankings)
			}
		</div>
	}
}

templ rankingsIndexEmptyState() {
	<div class="flex flex-col items-center justify-center gap-4 rounded-lg border border-border bg-surface px-6 py-20 text-center">
		<p class="text-sm text-text-muted">You haven't created a ranking yet.</p>
		@Button(ButtonProps{Variant: ButtonPrimary, Attrs: templ.Attributes{"hx-post": "/new"}}) {
			Create your first ranking
		}
	</div>
}

templ rankingsIndexList(cards []RankingsIndexCard) {
	<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		for _, card := range cards {
			<li class="rounded-lg border border-border bg-surface hover:bg-surface-hover">
				<div class="px-4 py-4">
					<a href={ templ.URL(card.URL) } class="block">
						<p class="font-medium text-text">{ card.Name }</p>
						<p class="mt-1 text-sm text-text-muted">
							if card.PublishedAt == "" {
								Unpublished
							} else {
								Last published { card.PublishedAt }
							}
						</p>
					</a>
					if card.DraftURL != "" {
						<a href={ templ.URL(card.DraftURL) } class="mt-1 inline-block text-sm text-text-muted underline hover:text-text-muted-hover">
							Continue draft &rarr;
						</a>
					}
				</div>
			</li>
		}
	</ul>
}
