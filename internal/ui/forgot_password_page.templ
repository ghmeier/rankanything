package ui

// ForgotPasswordProps shows the same Sent notice whether or not the address
// is registered, so a response can never test which emails have accounts.
type ForgotPasswordProps struct {
	CSRFToken string
	LoggedIn  bool
	Flash     string
	Email     string
	Error     string
	Sent      bool
}

templ ForgotPasswordPage(props ForgotPasswordProps) {
	@Layout(LayoutProps{Title: "Forgot password", CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash}) {
		<div class="mx-auto max-w-sm space-y-6">
			<h1 class="text-2xl font-bold tracking-tight">Reset your password</h1>
			@ForgotPasswordForm(props)
		</div>
	}
}

// ForgotPasswordForm carries its own id because POST /forgot-password swaps
// it back in without the page wrapper.
templ ForgotPasswordForm(props ForgotPasswordProps) {
	<div id="forgot-password-form" class="space-y-4">
		if props.Sent {
			@Notice(NoticeProps{Variant: NoticeSuccess}) {
				If an account exists for that address, we've sent a reset link.
			}
		} else {
			<form hx-post="/forgot-password" hx-target="#forgot-password-form" hx-swap="outerHTML" class="space-y-4">
				if props.Error != "" {
					@Notice(NoticeProps{Variant: NoticeError}) {
						{ props.Error }
					}
				}
				@Input(InputProps{
					Name:     "email",
					Type:     "email",
					Label:    "Email",
					Value:    props.Email,
					Required: true,
					Attrs:    templ.Attributes{"autocomplete": "email"},
				})
				@Button(ButtonProps{Type: "submit", Variant: ButtonPrimary}) {
					Send reset link
				}
			</form>
			<p class="text-sm text-text-muted">
				Remembered it? <a href="/login" class="text-text hover:underline">Sign in</a>.
			</p>
		}
	</div>
}
