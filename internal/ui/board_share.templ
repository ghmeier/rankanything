package ui

import "fmt"

type ShareControlProps struct {
	RankingUUID string
	Shareable bool
	Reasons   []string
	IsPublic  bool
	PublicURL string
	Open bool
}

templ ShareControl(props ShareControlProps) {
	<div id="share-control" class="group relative" open?={ props.Open }>
		if props.IsPublic {
			@DropdownItem(DropdownItemProps{
				Attrs: templ.Attributes{
					"onclick": "navigator.clipboard.writeText(\"" + props.PublicURL + "\")",
				},
			}) {
				@ShareIcon()
				Copy link
			}
			@DropdownItem(DropdownItemProps{
				Attrs: templ.Attributes{
					"hx-delete": fmt.Sprintf("/r/%s/share", props.RankingUUID),
					"hx-target": "#share-control",
					"hx-swap":   "outerHTML",
				},
			}) {
				Stop sharing
			}
		} else {
			@DropdownItem(DropdownItemProps{
				Attrs: templ.Attributes{
					"hx-post":   fmt.Sprintf("/r/%s/share", props.RankingUUID),
					"hx-target": "#share-control",
					"hx-swap":   "outerHTML",
				},
				Disabled: !props.Shareable,
			}) {
				@ShareIcon()
				Share
			}
		}
		if !props.Shareable {
			@Tooltip(TooltipProps{Width: "w-48", Placement: TooltipLeft}) {
				<p>To share this ranking:</p>
				<ul class="list-inside list-disc">
					for _, reason := range props.Reasons {
						<li class="whitespace-nowrap">{ reason }</li>
					}
				</ul>
			}
		}
	</div>
}
