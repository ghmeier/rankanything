package ui

import "fmt"

// ShareControlProps configures the board's share control: a "Share"
// disclosure gated on the ranking having a published version and the
// owner's email being verified. When either is missing, the control says
// which — an inert button with no explanation is worse than no control at
// all.
type ShareControlProps struct {
	RankingUUID string
	// Shareable and Reasons come from services.ShareGate: Shareable is
	// true only once both conditions hold, and Reasons lists whichever of
	// them don't.
	Shareable bool
	Reasons   []string
	// IsPublic and PublicURL describe the current ranking_shares row. If
	// IsPublic is false, PublicURL is meaningless and unused.
	IsPublic  bool
	PublicURL string
	// Open marks the disclosure expanded, for the fragment a toggle's own
	// hx-post/hx-delete swaps back in — so the panel that just changed
	// stays visible rather than collapsing shut.
	Open bool
}

// ShareControl is a disclosure nested inside the board's actions menu: the
// summary is a menu row like any other, and opening it expands the panel in
// place rather than flying out a second popover beside the first.
templ ShareControl(props ShareControlProps) {
	<details id="share-control" open?={ props.Open }>
		<summary class={ boardMenuItemClass, "list-none [&::-webkit-details-marker]:hidden" }>
			@ShareIcon()
			if props.IsPublic {
				Shared
			} else {
				Share
			}
		</summary>
		<div class="space-y-2 px-3 pt-1 pb-2 text-sm">
			if !props.Shareable {
				<p class="text-text-muted">Sharing isn't available yet:</p>
				<ul class="list-disc space-y-1 pl-4 text-xs text-text-muted">
					for _, reason := range props.Reasons {
						<li>{ reason }</li>
					}
				</ul>
			} else if props.IsPublic {
				<p class="text-xs text-text-muted">Anyone with this link can view the ranking's live published version, read-only. It follows whatever you publish next.</p>
				<input
					id="share-link-input"
					type="text"
					readonly
					value={ props.PublicURL }
					aria-label="Public share link"
					class="w-full rounded-md border border-border bg-surface-muted px-2 py-1 text-xs text-text"
					onclick="this.select()"
				/>
				@Button(ButtonProps{
					Variant: ButtonSecondary,
					Class:   "w-full",
					Attrs: templ.Attributes{
						"onclick": "navigator.clipboard.writeText(document.getElementById('share-link-input').value)",
					},
				}) {
					Copy link
				}
				<p class="text-xs text-text-muted">Turning this off kills the link for good. Sharing again creates a brand new one — the old link never comes back.</p>
				@Button(ButtonProps{
					Variant: ButtonDestructive,
					Class:   "w-full",
					Attrs: templ.Attributes{
						"hx-delete": fmt.Sprintf("/r/%s/share", props.RankingUUID),
						"hx-target": "#share-control",
						"hx-swap":   "outerHTML",
					},
				}) {
					Stop sharing
				}
			} else {
				<p class="text-xs text-text-muted">Create a public read-only link to the live published version. Turning it off later kills the link for good — sharing again creates a new one.</p>
				@Button(ButtonProps{
					Variant: ButtonPrimary,
					Class:   "w-full",
					Attrs: templ.Attributes{
						"hx-post":   fmt.Sprintf("/r/%s/share", props.RankingUUID),
						"hx-target": "#share-control",
						"hx-swap":   "outerHTML",
					},
				}) {
					Create share link
				}
			}
		</div>
	</details>
}
