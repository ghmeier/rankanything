package ui

// PublicBoardPageProps is the read-only view of a ranking's live version. It
// carries none of BoardPageProps' editing plumbing, so nothing on the page
// implies a visitor can change it.
type PublicBoardPageProps struct {
	CSRFToken string
	LoggedIn  bool
	Flash     string
	Theme     string
	// Feeds <title>, the meta description, and the Open Graph tags.
	Title        string
	Description  string
	CanonicalURL string
	RankingMeta  RankingMetaProps
	Tiers        []TierRowProps
	ItemTray     ItemTrayProps
}

templ PublicBoardPage(props PublicBoardPageProps) {
	@Layout(LayoutProps{
		Title:       props.Title,
		Description: props.Description,
		CSRFToken:   props.CSRFToken,
		LoggedIn:    props.LoggedIn,
		Flash:       props.Flash,
		Theme:       props.Theme,
		Wide:        true,
		OpenGraph: &OpenGraphProps{
			Title:       props.Title,
			Description: props.Description,
			Type:        "website",
			URL:         props.CanonicalURL,
		},
	}) {
		<div class="space-y-4">
			<section class="space-y-2">
				@RankingMeta(props.RankingMeta)
				<p class="text-xs uppercase tracking-wide text-text-muted">Shared read-only view · live published version</p>
			</section>
			<div class="space-y-4">
				@TierRows(TierRowsProps{Tiers: props.Tiers})
				@ItemTray(props.ItemTray)
			</div>
		</div>
	}
}
