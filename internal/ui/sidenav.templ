package ui

templ SideNav() {
	<nav
		aria-label="Main"
		class="fixed inset-x-0 bottom-0 z-30 flex h-14 flex-row items-center justify-center gap-2 border-t border-border bg-background px-2 md:inset-x-auto md:inset-y-0 md:left-0 md:h-full md:w-14 md:flex-col md:justify-start md:gap-2 md:border-t-0 md:border-r md:px-0 md:py-4"
	>
		<a
			href="/"
			aria-label="Rank Anything home"
			class="flex size-10 shrink-0 items-center justify-center rounded-md text-lg font-semibold tracking-tight text-text hover:bg-surface-hover"
		>
			<span class="text-text-muted">r</span>a
		</a>
		@sideNavItem(sideNavItemProps{Label: "Rankings", Href: "/me"}) {
			@ListIcon()
		}
		@sideNavItem(sideNavItemProps{Label: "Account", Href: "/account"}) {
			@UserIcon()
		}
		@sideNavItem(sideNavItemProps{Label: "Sign out", Attrs: templ.Attributes{"hx-post": "/logout"}}) {
			@SignOutIcon()
		}
	</nav>
}

type sideNavItemProps struct {
	Label string
	Href  string
	Attrs templ.Attributes
}

templ sideNavItem(props sideNavItemProps) {
	<div class="group relative">
		if props.Href != "" {
			<a href={ templ.URL(props.Href) } aria-label={ props.Label } class={ sideNavItemClass }>
				{ children... }
			</a>
		} else {
			<button type="button" aria-label={ props.Label } class={ sideNavItemClass } { props.Attrs... }>
				{ children... }
			</button>
		}
		@Tooltip(TooltipProps{Placement: TooltipRight, Width: "whitespace-nowrap"}) {
			{ props.Label }
		}
	</div>
}

const sideNavItemClass = "flex size-10 cursor-pointer items-center justify-center rounded-md text-xl text-text-muted hover:bg-surface-hover hover:text-text-muted-hover"
