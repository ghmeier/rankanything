package ui

templ ComponentsGallery() {
	@Layout(LayoutProps{Title: "Components", CSRFToken: "gallery-preview-token", LoggedIn: false}) {
		<div class="space-y-12 pb-16">
			<script>
				(function () {
					try {
						var saved = localStorage.getItem("rankanything-theme");
						if (saved === "dark" || saved === "light") {
							document.documentElement.setAttribute("data-theme", saved);
						}
					} catch (e) {}
				})();
				function rankanythingToggleTheme() {
					var root = document.documentElement;
					var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
					root.setAttribute("data-theme", next);
					try {
						localStorage.setItem("rankanything-theme", next);
					} catch (e) {}
				}
			</script>
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Component gallery</h1>
				<button
					id="theme-toggle"
					type="button"
					class={ ButtonClass(ButtonSecondary) }
					onclick="rankanythingToggleTheme()"
				>
					Toggle theme
				</button>
			</div>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Button</h2>
				<div class="flex flex-wrap items-center gap-3">
					@Button(ButtonProps{Variant: ButtonPrimary}) {
						Primary
					}
					@Button(ButtonProps{Variant: ButtonSecondary}) {
						Secondary
					}
					@Button(ButtonProps{Variant: ButtonTertiary}) {
						Tertiary
					}
					@Button(ButtonProps{Variant: ButtonDestructive}) {
						Destructive
					}
					@Button(ButtonProps{Variant: ButtonPrimary, Disabled: true}) {
						Disabled
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">IconButton</h2>
				<div class="flex flex-wrap items-center gap-3">
					@IconButton(IconButtonProps{Label: "Edit"}) {
						@EditIcon()
					}
					@IconButton(IconButtonProps{Label: "Save"}) {
						@SaveIcon()
					}
					@IconButton(IconButtonProps{Label: "Delete", Variant: ButtonDestructive}) {
						@CloseIcon()
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Dropdown</h2>
				<p class="text-sm text-text-muted">
					A labelled trigger flips its chevron while the panel is open. An icon
					trigger carries its name in aria-label instead. Both close on a click
					outside or on Escape.
				</p>
				<div class="flex flex-wrap items-start gap-3 pb-40">
					@Dropdown(DropdownProps{Label: "Version 3", Variant: ButtonSecondary, Width: "w-56"}) {
						@DropdownItem(DropdownItemProps{Current: true}) {
							Version 3 — draft
						}
						@DropdownItem(DropdownItemProps{Href: "#"}) {
							Version 2 — published
						}
						@DropdownItem(DropdownItemProps{Href: "#"}) {
							Version 1 — published
						}
					}
					@Dropdown(DropdownProps{Icon: MoreIcon(), AriaLabel: "More actions", Variant: ButtonSecondary, Align: DropdownRight}) {
						@DropdownItem(DropdownItemProps{}) {
							@EditIcon()
							Rename
						}
						@DropdownItem(DropdownItemProps{}) {
							@ShareIcon()
							Copy link
						}
						@DropdownItem(DropdownItemProps{Disabled: true}) {
							@DownloadIcon()
							Export CSV
						}
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">SplitButton</h2>
				<p class="text-sm text-text-muted">
					One action, plus a menu of the ones related to it. Both halves take the
					same variant, so the seam between them reads as a single control.
				</p>
				<div class="flex flex-wrap items-start gap-3 pb-40">
					@SplitButton(SplitButtonProps{Label: "Publish", Variant: ButtonPrimary}) {
						@Dropdown(DropdownProps{Icon: MoreIcon(), AriaLabel: "More publish actions", Variant: ButtonPrimary, Align: DropdownRight, Split: true}) {
							@DropdownItem(DropdownItemProps{}) {
								@EditIcon()
								Edit tiers
							}
							@DropdownItem(DropdownItemProps{}) {
								@ShareIcon()
								Share
							}
						}
					}
					@SplitButton(SplitButtonProps{Label: "New version", Variant: ButtonSecondary}) {
						@Dropdown(DropdownProps{Icon: MoreIcon(), AriaLabel: "More version actions", Variant: ButtonSecondary, Align: DropdownRight, Split: true}) {
							@DropdownItem(DropdownItemProps{}) {
								@DownloadIcon()
								Export CSV
							}
						}
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Input</h2>
				<div class="grid max-w-sm gap-4">
					@Input(InputProps{Label: "Email", Name: "email", Type: "email", Placeholder: "you@example.com"})
					@Input(InputProps{
						Label: "Password",
						Name:  "password",
						Type:  "password",
						Error: "Password must be at least 8 characters",
					})
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Notice</h2>
				<div class="grid max-w-sm gap-4">
					@Notice(NoticeProps{Variant: NoticeSuccess, Dismissable: true, ID: "ranking-saved"}) {
						Ranking saved.
					}
					@Notice(NoticeProps{Variant: NoticeError}) {
						Something went wrong. Try again.
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Tooltip</h2>
				<p class="text-sm text-text-muted">Hover a trigger.</p>
				<div class="flex items-center gap-12 py-8">
					<div class="group relative">
						@Button(ButtonProps{Variant: ButtonPrimary}) {
							Above
						}
						@Tooltip(TooltipProps{Width: "w-48", Placement: TooltipTop}) {
							<p>Sits above its trigger.</p>
						}
					</div>
					<div class="group relative">
						@Button(ButtonProps{Variant: ButtonSecondary}) {
							Beside
						}
						@Tooltip(TooltipProps{Placement: TooltipRight}) {
							Sits beside its trigger.
						}
					</div>
					<div class="group relative">
						@Button(ButtonProps{Variant: ButtonTertiary}) {
							Below
						}
						@Tooltip(TooltipProps{Width: "whitespace-nowrap"}) {
							Sits below its trigger.
						}
					</div>
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Navigation</h2>
				<p class="text-sm text-text-muted">
					A signed-in page gets SideNav, a signed-out one gets TopNav. The rail is
					position: fixed in the real layout, so its preview box sets a transform,
					which makes the box itself the containing block and lands the rail inside
					it instead of over the page.
				</p>
				<p class="text-sm text-text-muted">SideNav — signed in</p>
				<div class="relative h-64 translate-x-0 overflow-hidden rounded-md border border-border">
					@SideNav()
				</div>
				<p class="text-sm text-text-muted">TopNav — signed out</p>
				<div class="relative overflow-hidden rounded-md border border-border">
					@TopNav()
				</div>
			</section>
		</div>
	}
}
