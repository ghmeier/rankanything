package ui

// ComponentsGallery renders every component in every variant, so a look can
// be checked without navigating to a page that uses it. Its theme toggle sets
// data-theme, which input.css gives priority over prefers-color-scheme.
templ ComponentsGallery() {
	@Layout(LayoutProps{Title: "Components", CSRFToken: "gallery-preview-token", LoggedIn: false}) {
		<div class="space-y-12 pb-16">
			<script>
				(function () {
					try {
						var saved = localStorage.getItem("rankanything-theme");
						if (saved === "dark" || saved === "light") {
							document.documentElement.setAttribute("data-theme", saved);
						}
					} catch (e) {}
				})();
				function rankanythingToggleTheme() {
					var root = document.documentElement;
					var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
					root.setAttribute("data-theme", next);
					try {
						localStorage.setItem("rankanything-theme", next);
					} catch (e) {}
				}
			</script>
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Component gallery</h1>
				<button
					id="theme-toggle"
					type="button"
					class={ ButtonClass(ButtonSecondary) }
					onclick="rankanythingToggleTheme()"
				>
					Toggle theme
				</button>
			</div>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Button</h2>
				<div class="flex flex-wrap items-center gap-3">
					@Button(ButtonProps{Variant: ButtonPrimary}) {
						Primary
					}
					@Button(ButtonProps{Variant: ButtonSecondary}) {
						Secondary
					}
					@Button(ButtonProps{Variant: ButtonTertiary}) {
						Tertiary
					}
					@Button(ButtonProps{Variant: ButtonDestructive}) {
						Destructive
					}
					@Button(ButtonProps{Variant: ButtonPrimary, Disabled: true}) {
						Disabled
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">IconButton</h2>
				<div class="flex flex-wrap items-center gap-3">
					@IconButton(IconButtonProps{Label: "Edit"}) {
						@EditIcon()
					}
					@IconButton(IconButtonProps{Label: "Save"}) {
						@SaveIcon()
					}
					@IconButton(IconButtonProps{Label: "Delete", Variant: ButtonDestructive}) {
						@CloseIcon()
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Input</h2>
				<div class="grid max-w-sm gap-4">
					@Input(InputProps{Label: "Email", Name: "email", Type: "email", Placeholder: "you@example.com"})
					@Input(InputProps{
						Label: "Password",
						Name:  "password",
						Type:  "password",
						Error: "Password must be at least 8 characters",
					})
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">Notice</h2>
				<div class="grid max-w-sm gap-4">
					@Notice(NoticeProps{Variant: NoticeSuccess, Dismissable: true, ID: "ranking-saved"}) {
						Ranking saved.
					}
					@Notice(NoticeProps{Variant: NoticeError}) {
						Something went wrong. Try again.
					}
				</div>
			</section>
			<section class="space-y-4">
				<h2 class="text-lg font-semibold">NavBar</h2>
				<p class="text-sm text-text-muted">Signed out</p>
				<div class="overflow-hidden rounded-md border border-border">
					@NavBar(NavBarProps{LoggedIn: false})
				</div>
				<p class="text-sm text-text-muted">Signed in</p>
				<div class="overflow-hidden rounded-md border border-border">
					@NavBar(NavBarProps{LoggedIn: true})
				</div>
			</section>
		</div>
	}
}
