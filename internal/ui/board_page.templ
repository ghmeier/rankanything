package ui

import (
	"cmp"
	"fmt"
)

type BoardPageProps struct {
	CSRFToken     string
	LoggedIn      bool
	Flash         string
	Theme         string
	RankingMeta   RankingMetaProps
	Versions      []BoardVersionOption
	VersionAction BoardVersionActionsProps
	Editable bool
	Tiers    []TierRowProps
	TierForm TierFormProps
	ItemTray ItemTrayProps
	ShareControl  templ.Component
	ExportControl templ.Component
}

type RankingMetaProps struct {
	RankingUUID      string
	VersionShortUUID string
	Name             string
	Description      string
	Editable bool
}

templ BoardPage(props BoardPageProps) {
	@Layout(LayoutProps{Title: cmp.Or(props.RankingMeta.Name, "Untitled ranking"), CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash, Theme: props.Theme, Wide: true}) {
		<div class="space-y-4">
			<section class="flex flex-row items-start justify-between gap-2">
				<form
					class="flex-1 space-y-2"
					hx-post={ fmt.Sprintf("/r/%s", props.RankingMeta.RankingUUID) }
					hx-target="#ranking-meta"
					hx-swap="outerHTML"
				>
					@RankingMeta(props.RankingMeta)
				</form>
				<div class="flex shrink-0 flex-row items-center gap-2">
					@boardVersionMenu(props.Versions)
					@SplitButton(SplitButtonProps{Action: BoardVersionActions(props.VersionAction)}) {
						@boardActionsMenu(props)
					}
				</div>
			</section>
			<div id="board" data-ranking-uuid={ props.RankingMeta.RankingUUID } data-version-uuid={ props.RankingMeta.VersionShortUUID } class="space-y-4">
				@TierRows(TierRowsProps{Tiers: props.Tiers})
				if props.Editable {
					@TierForm(props.TierForm)
				}
				if props.Editable || len(props.ItemTray.Unassigned) != 0 {
					@ItemTray(props.ItemTray)
				}
			</div>
			<script src="/static/js/board.js" defer></script>
			<div id="share-modal-container"></div>
		</div>
	}
}

type BoardVersionActionsProps struct {
	RankingUUID      string
	VersionShortUUID string
	IsDraft          bool
	Publishable      bool
	BlockedReasons   []string
	HasOtherDraft    bool
	DraftURL         string
	OOB bool
}

templ BoardVersionActions(props BoardVersionActionsProps) {
	<div
		id="board-version-actions"
		class="flex group relative"
		if props.OOB {
			hx-swap-oob="true"
		}
	>
		if props.IsDraft {
			@Button(ButtonProps{Variant: ButtonPrimary, Class: SplitButtonActionClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/v/%s/publish", props.RankingUUID, props.VersionShortUUID)}, Disabled: !props.Publishable}) {
				Publish
			}
			if !props.Publishable {
				@Tooltip(TooltipProps{Width: "w-48", Placement: TooltipBottom}) {
					<p>To publish this version:</p>
					<ul class="list-inside list-disc">
						for _, reason := range props.BlockedReasons {
							<li class="whitespace-nowrap">{ reason }</li>
						}
					</ul>
				}
			}
		} else if props.HasOtherDraft {
			<a href={ templ.URL(props.DraftURL) } class={ ButtonClass(ButtonSecondary), SplitButtonActionClass }>
				Edit draft
			</a>
		} else {
			@Button(ButtonProps{Variant: ButtonSecondary, Class: SplitButtonActionClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/versions", props.RankingUUID)}}) {
				New version
			}
		}
	</div>
}

templ boardActionsMenu(props BoardPageProps) {
	@Dropdown(DropdownProps{
		Icon:      MoreIcon(),
		AriaLabel: "More actions",
		Variant:   boardActionsMenuVariant(props.Editable),
		Align:     DropdownRight,
		Split:     true,
	}) {
		if props.Editable {
			@editTiersToggle()
		}
		if props.ShareControl != nil {
			@props.ShareControl
		}
		if props.ExportControl != nil {
			@props.ExportControl
		}
	}
}

// Checkbox so CSS can key off :checked without JS.
templ editTiersToggle() {
	<input type="checkbox" id="edit-tiers" class="peer sr-only"/>
	<label for="edit-tiers" class={ DropdownItemClass + " peer-focus-visible:bg-surface-hover" }>
		@EditIcon()
		<span data-edit-tiers-label="start">Edit tiers</span>
		<span data-edit-tiers-label="stop">Stop editing</span>
	</label>
}

func boardActionsMenuVariant(editable bool) ButtonVariant {
	if editable {
		return ButtonPrimary
	}
	return ButtonSecondary
}

templ RankingMeta(props RankingMetaProps) {
	<div id="ranking-meta" class="space-y-2">
		if props.Editable {
			<input
				name="title"
				value={ props.Name }
				aria-label="Ranking title"
				class="w-full border-b border-transparent text-2xl font-bold tracking-tight text-text outline-none placeholder:text-text-subtle hover:border-border focus:border-border"
				placeholder="Untitled ranking"
				hx-post={ fmt.Sprintf("/r/%s", props.RankingUUID) }
				hx-target="#ranking-meta"
				hx-swap="outerHTML"
				hx-trigger="change"
			/>
		} else {
			<p class="w-full text-2xl font-bold tracking-tight text-text">{ cmp.Or(props.Name, "Untitled ranking") }</p>
		}
		@RankingDescription(RankingDescriptionProps{
			RankingUUID: props.RankingUUID,
			Description: props.Description,
			Editable:    props.Editable,
		})
	</div>
}
