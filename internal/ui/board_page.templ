package ui

import (
	"cmp"
	"fmt"
)

// BoardPageProps configures the whole tier board for one version.
type BoardPageProps struct {
	CSRFToken     string
	LoggedIn      bool
	Flash         string
	Theme         string
	RankingMeta   RankingMetaProps
	Versions      []BoardVersionOption
	VersionAction BoardVersionActionsProps
	// A published version is immutable, so editing affordances are left
	// unrendered rather than merely disabled.
	Editable bool
	Tiers    []TierRowProps
	TierForm TierFormProps
	ItemTray ItemTrayProps
	// Nil renders nothing for either control.
	ShareControl  templ.Component
	ExportControl templ.Component
}

// RankingMetaProps carries RankingUUID because editing a field renders this
// standalone as an htmx swap target, with no surrounding page.
type RankingMetaProps struct {
	RankingUUID      string
	VersionShortUUID string
	Name             string
	Description      string
	// A ranking's name is not version-scoped, but this page shouldn't offer
	// inputs that look like they edit the published version on screen.
	Editable bool
}

templ BoardPage(props BoardPageProps) {
	@Layout(LayoutProps{Title: cmp.Or(props.RankingMeta.Name, "Untitled ranking"), CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash, Theme: props.Theme}) {
		<div class="space-y-4">
			<section class="flex flex-row items-start justify-between gap-2">
				<form
					class="flex-1 space-y-2"
					hx-post={ fmt.Sprintf("/r/%s", props.RankingMeta.RankingUUID) }
					hx-target="#ranking-meta"
					hx-swap="outerHTML"
				>
					@RankingMeta(props.RankingMeta)
				</form>
				<div class="flex shrink-0 flex-row items-center gap-2">
					@boardVersionMenu(props.Versions)
					<div class="flex items-stretch">
						@BoardVersionActions(props.VersionAction)
						@boardActionsMenu(props)
					</div>
				</div>
			</section>
			<div id="board" data-ranking-uuid={ props.RankingMeta.RankingUUID } data-version-uuid={ props.RankingMeta.VersionShortUUID } class="space-y-4">
				@TierRows(TierRowsProps{Tiers: props.Tiers})
				if props.Editable {
					@TierForm(props.TierForm)
				}
				if props.Editable || len(props.ItemTray.Unassigned) != 0 {
					@ItemTray(props.ItemTray)
				}
			</div>
			<script src="/static/js/board.js" defer></script>
		</div>
	}
}

// BoardVersionActionsProps renders the publish action for a draft, or the
// branch action for a published version with no draft in progress.
type BoardVersionActionsProps struct {
	RankingUUID      string
	VersionShortUUID string
	IsDraft          bool
	Publishable      bool
	BlockedReasons   []string
	HasOtherDraft    bool
	DraftURL         string
	// OOB rides along with a mutation's own fragment, so the publish button
	// re-evaluates the moment a change flips the gate.
	OOB bool
}

templ BoardVersionActions(props BoardVersionActionsProps) {
	<div
		id="board-version-actions"
		class="flex group relative"
		if props.OOB {
			hx-swap-oob="true"
		}
	>
		if props.IsDraft {
			@Button(ButtonProps{Variant: ButtonPrimary, Class: splitButtonPrimaryClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/v/%s/publish", props.RankingUUID, props.VersionShortUUID)}, Disabled: !props.Publishable}) {
				Publish
			}
			if !props.Publishable {
				<div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-opacity absolute bottom-full left-1/2 z-10 mb-2 w-48 -translate-x-1/2 rounded bg-surface p-2 text-xs text-text">
					<p>To publish this version:</p>
					<ul class="list-disc list-inside">
						for _, reason := range props.BlockedReasons {
							<li class="whitespace-nowrap">{ reason }</li>
						}
					</ul>
					<div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-surface"></div>
				</div>
			}
		} else if props.HasOtherDraft {
			<a href={ templ.URL(props.DraftURL) } class={ ButtonClass(ButtonSecondary), splitButtonPrimaryClass }>
				Edit draft
			</a>
		} else {
			@Button(ButtonProps{Variant: ButtonSecondary, Class: splitButtonPrimaryClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/versions", props.RankingUUID)}}) {
				New version
			}
		}
	</div>
}

// The split button's halves drop their adjoining corners and overlap by a
// pixel, so the two borders read as one line.
const (
	splitButtonPrimaryClass = "rounded-r-none"
	splitButtonMenuClass    = "rounded-l-none"
)

// boardActionsMenu is a native <details>, so it opens without JS. It stays
// styled as secondary even beside a disabled Publish button, because the
// actions behind it are still available. The share control keeps its own
// nested disclosure because its panel is a form, not a link.
templ boardActionsMenu(props BoardPageProps) {
	<details class="relative" data-menu>
		<summary class={ boardActionMenuButtonClass(props.Editable) } aria-label="More actions">
			@MoreIcon()
		</summary>
		<div class="absolute right-0 z-20 mt-1 w-fit rounded-md border border-border bg-surface p-1 text-left shadow-md">
			if props.Editable {
				@editTiersToggle()
			}
			if props.ShareControl != nil {
				@props.ShareControl
			}
			if props.ExportControl != nil {
				@props.ExportControl
			}
		</div>
	</details>
}

// editTiersToggle is a checkbox rather than a button because edit-tiers mode
// is pure client-side UI state: input.css keys the tier affordances and this
// control's own label off :checked, so the mode works with board.js blocked,
// and a checkbox is what a screen reader should hear for a toggle anyway.
// board.js only listens for the change to close the menu.
templ editTiersToggle() {
	<input type="checkbox" id="edit-tiers" class="peer sr-only"/>
	<label for="edit-tiers" class={ boardMenuItemClass + " peer-focus-visible:bg-surface-hover" }>
		@EditIcon()
		<span data-edit-tiers-label="start">Edit tiers</span>
		<span data-edit-tiers-label="stop">Stop editing</span>
	</label>
}

func boardActionMenuButtonClass(editable bool) string {
	className := splitButtonMenuClass + " h-full border-l border-border list-none [&::-webkit-details-marker]:hidden "
	if editable {
		className += ButtonClass(ButtonPrimary)
	} else {
		className += ButtonClass(ButtonSecondary)
	}

	return className
}

const boardMenuItemClass = "flex w-full cursor-pointer items-center gap-2 rounded px-3 py-2 text-left text-sm text-text-muted whitespace-nowrap hover:bg-surface-hover hover:text-text-muted-hover disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"

type BoardMenuItemProps struct {
	Disabled bool
	Attrs    templ.Attributes
}

templ BoardMenuItem(props BoardMenuItemProps) {
	<button type="button" disabled?={ props.Disabled } class={ boardMenuItemClass } { props.Attrs... }>
		{ children... }
	</button>
}

templ RankingMeta(props RankingMetaProps) {
	<div id="ranking-meta" class="space-y-2">
		if props.Editable {
			<input
				name="title"
				value={ props.Name }
				aria-label="Ranking title"
				class="w-full text-2xl font-bold tracking-tight text-text outline-none placeholder:text-subtle focus:border-b focus:border-border"
				placeholder="Untitled ranking"
				hx-post={ fmt.Sprintf("/r/%s", props.RankingUUID) }
				hx-target="#ranking-meta"
				hx-swap="outerHTML"
				hx-trigger="change"
			/>
			<input
				name="description"
				value={ props.Description }
				aria-label="Ranking description"
				class="w-full text-sm text-muted outline-none placeholder:text-subtle"
				placeholder="What are you ranking?"
				hx-post={ fmt.Sprintf("/r/%s", props.RankingUUID) }
				hx-target="#ranking-meta"
				hx-swap="outerHTML"
				hx-trigger="change"
			/>
		} else {
			<p class="w-full text-2xl font-bold tracking-tight text-text">{ cmp.Or(props.Name, "Untitled ranking") }</p>
			if props.Description != "" {
				<p class="w-full text-sm text-muted">{ props.Description }</p>
			}
		}
	</div>
}
