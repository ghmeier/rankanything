package ui

import (
	"cmp"
	"fmt"
)

// BoardPageProps configures BoardPage — the whole tier board for one
// version of a ranking.
type BoardPageProps struct {
	CSRFToken     string
	LoggedIn      bool
	Flash         string
	Theme         string
	RankingMeta   RankingMetaProps
	Versions      []BoardVersionOption
	VersionAction BoardVersionActionsProps
	// Editable is false while viewing a published version: a version is
	// immutable once published, so every editing affordance (tier editing,
	// the add-item form, drag handles, delete controls) is left unrendered
	// rather than merely disabled.
	Editable bool
	Tiers    []TierRowProps
	TierForm TierFormProps
	ItemTray ItemTrayProps
	// ShareControl is the seam feat/public-share fills with a share button;
	// nil renders nothing.
	ShareControl templ.Component
	// ExportControl is the seam feat/csv-export fills with a CSV export
	// button; nil renders nothing.
	ExportControl templ.Component
}

// RankingMetaProps renders the title/description fields. It is rendered
// both inside BoardPage and standalone as the htmx swap target when a field
// is edited, so it carries RankingUUID itself.
type RankingMetaProps struct {
	RankingUUID      string
	VersionShortUUID string
	Name             string
	Description      string
	// Editable is false while viewing a published version: the ranking's
	// name isn't itself version-scoped and stays editable elsewhere, but
	// this page shouldn't offer inputs that look like they're editing the
	// published version being viewed.
	Editable bool
}

templ BoardPage(props BoardPageProps) {
	@Layout(LayoutProps{Title: cmp.Or(props.RankingMeta.Name, "Untitled ranking"), CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash, Theme: props.Theme}) {
		<div class="space-y-4">
			<section class="flex flex-row items-start justify-between gap-2">
				<form
					class="flex-1 space-y-2"
					hx-post={ fmt.Sprintf("/r/%s", props.RankingMeta.RankingUUID) }
					hx-target="#ranking-meta"
					hx-swap="outerHTML"
				>
					@RankingMeta(props.RankingMeta)
				</form>
				<div class="flex shrink-0 flex-row items-center gap-2">
					@boardVersionMenu(props.Versions)
					<div class="flex items-stretch">
						@BoardVersionActions(props.VersionAction)
						@boardActionsMenu(props)
					</div>
				</div>
			</section>
			<div id="board" data-ranking-uuid={ props.RankingMeta.RankingUUID } data-version-uuid={ props.RankingMeta.VersionShortUUID } class="space-y-4">
				@TierRows(TierRowsProps{Tiers: props.Tiers})
				if props.Editable {
					@TierForm(props.TierForm)
				}
				if props.Editable || len(props.ItemTray.Unassigned) != 0 {
					@ItemTray(props.ItemTray)
				}
			</div>
			<script src="/static/js/board.js" defer></script>
		</div>
	}
}

// BoardVersionActionsProps renders the publish/branch action for the
// version being viewed: a draft shows why publishing is blocked or a
// working publish button; a published version offers to branch a new draft,
// unless the ranking already has one in progress.
type BoardVersionActionsProps struct {
	RankingUUID      string
	VersionShortUUID string
	IsDraft          bool
	Publishable      bool
	BlockedReasons   []string
	HasOtherDraft    bool
	DraftURL         string
	// OOB marks this render as an out-of-band swap, sent alongside a board
	// mutation's own fragment so the publish button re-evaluates the moment
	// a change flips the gate, rather than staying stale until the next
	// full page load.
	OOB bool
}

templ BoardVersionActions(props BoardVersionActionsProps) {
	<div
		id="board-version-actions"
		class="flex"
		if props.OOB {
			hx-swap-oob="true"
		}
	>
		if props.IsDraft {
			@Button(ButtonProps{Variant: ButtonPrimary, Class: splitButtonPrimaryClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/v/%s/publish", props.RankingUUID, props.VersionShortUUID)}, Disabled: !props.Publishable}) {
				Publish
			}
		} else if props.HasOtherDraft {
			<a href={ templ.URL(props.DraftURL) } class={ ButtonClass(ButtonSecondary), splitButtonPrimaryClass }>
				Continue editing draft
			</a>
		} else {
			@Button(ButtonProps{Variant: ButtonSecondary, Class: splitButtonPrimaryClass, Attrs: templ.Attributes{"hx-post": fmt.Sprintf("/r/%s/versions", props.RankingUUID)}}) {
				Create new version
			}
		}
	</div>
}

// The two halves of the split button share a seam: the primary half drops
// its right corners, the menu half its left ones, and the menu half pulls a
// pixel left so the adjoining borders overlap into one line.
const (
	splitButtonPrimaryClass = "rounded-r-none"
	splitButtonMenuClass    = "-ml-px rounded-l-none px-2"
)

// boardActionsMenu is the second half of the split button: a disclosure
// holding the actions that aren't the primary one (editing tiers, sharing,
// exporting). Like boardVersionMenu it is a native <details>, so it needs no
// JS to open. The share control keeps its own nested disclosure rather than
// being flattened into a row, because its panel is a form, not a link.
//
// It stays secondary even when the primary half is the Publish button: a
// blocked publish renders disabled, and a menu half that matched it would
// look disabled too, when the actions behind it are all still available.
templ boardActionsMenu(props BoardPageProps) {
	<details class="group relative" data-menu>
		<summary class={ ButtonClass(ButtonSecondary), splitButtonMenuClass, "list-none [&::-webkit-details-marker]:hidden" } aria-label="More actions">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 transition-transform duration-150 group-open:rotate-180" aria-hidden="true">
				<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
			</svg>
		</summary>
		<div class="absolute right-0 z-20 mt-1 w-72 rounded-md border border-border bg-surface p-1 text-left shadow-md">
			if props.Editable {
				<button id="edit-tiers-toggle" type="button" class={ boardMenuItemClass }>
					@EditIcon()
					<span data-edit-tiers-label>Edit tiers</span>
				</button>
			}
			if props.ShareControl != nil {
				@props.ShareControl
			}
			if props.ExportControl != nil {
				@props.ExportControl
			}
		</div>
	</details>
}

// boardMenuItemClass is the shared look of a row in the actions menu. The
// share and export controls live in their own files but render into this
// menu, so they reach for the same constant rather than each restating it.
const boardMenuItemClass = "flex w-full cursor-pointer items-center gap-2 rounded px-3 py-2 text-left text-sm text-text-muted hover:bg-surface-hover hover:text-text-muted-hover"

templ RankingMeta(props RankingMetaProps) {
	<div id="ranking-meta" class="space-y-2">
		if props.Editable {
			<input
				name="title"
				value={ props.Name }
				aria-label="Ranking title"
				class="w-full text-2xl font-bold tracking-tight text-text outline-none placeholder:text-subtle focus:border-b focus:border-border"
				placeholder="Untitled ranking"
				hx-post={ fmt.Sprintf("/r/%s", props.RankingUUID) }
				hx-target="#ranking-meta"
				hx-swap="outerHTML"
				hx-trigger="change"
			/>
			<input
				name="description"
				value={ props.Description }
				aria-label="Ranking description"
				class="w-full text-sm text-muted outline-none placeholder:text-subtle"
				placeholder="What are you ranking?"
				hx-post={ fmt.Sprintf("/r/%s", props.RankingUUID) }
				hx-target="#ranking-meta"
				hx-swap="outerHTML"
				hx-trigger="change"
			/>
		} else {
			<p class="w-full text-2xl font-bold tracking-tight text-text">{ cmp.Or(props.Name, "Untitled ranking") }</p>
			if props.Description != "" {
				<p class="w-full text-sm text-muted">{ props.Description }</p>
			}
		}
	</div>
}
