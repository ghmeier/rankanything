package ui

// AuthFormProps is shared by the sign-in and create-account pages; only
// Action and Submit differ. EmailAlreadyRegistered is separate from Error
// because it is the one rejection that needs links rather than a sentence.
type AuthFormProps struct {
	Action                 string
	Submit                 string
	Email                  string
	Next                   string
	Error                  string
	EmailAlreadyRegistered bool

	// Tells a password manager whether to offer a saved credential
	// ("current-password") or generate one ("new-password").
	PasswordAutocomplete string
}

// AuthErrorSwapScript opts 401 and 422 back into htmx swapping, since htmx
// swaps only 2xx by default and a rejected attempt answers with the form.
//
// It belongs on the page, not in AuthForm: the form is inside the element the
// swap replaces, so a copy there would add a listener on every failure.
templ AuthErrorSwapScript() {
	<script>
		document.addEventListener("htmx:beforeSwap", (event) => {
			const status = event.detail.xhr.status;
			if (status === 401 || status === 422) {
				event.detail.shouldSwap = true;
				event.detail.isError = false;
			}
		});
	</script>
}

templ AuthForm(props AuthFormProps) {
	<form
		hx-post={ props.Action }
		hx-target="closest .auth-container"
		hx-swap="outerHTML"
		class="space-y-4"
	>
		<input type="hidden" name="next" value={ props.Next }/>
		if props.EmailAlreadyRegistered {
			@Notice(NoticeProps{Variant: NoticeError}) {
				This email is already registered.
				<a href="/login" class="underline">Try logging in</a>
				or
				<a href="/forgot-password" class="underline">reset your password</a>.
			}
		} else if props.Error != "" {
			@Notice(NoticeProps{Variant: NoticeError}) {
				{ props.Error }
			}
		}
		@Input(InputProps{
			Name:     "email",
			Type:     "email",
			Label:    "Email",
			Value:    props.Email,
			Required: true,
			Attrs:    templ.Attributes{"autocomplete": "email"},
		})
		@Input(InputProps{
			Name:     "password",
			Type:     "password",
			Label:    "Password",
			Required: true,
			Attrs:    templ.Attributes{"autocomplete": props.PasswordAutocomplete, "minlength": "8"},
		})
		// Not @Button: this spans the form's width, and Button writes its own
		// class, so a second one through Attrs would be ignored.
		<button type="submit" class={ ButtonClass(ButtonPrimary) + " w-full" }>
			{ props.Submit }
		</button>
	</form>
}
