package ui

import "fmt"

// RankingDescriptionProps configures both halves of the click-to-edit
// description. RankingUUID rides along because each half is rendered
// standalone as an htmx swap target, with no surrounding page.
type RankingDescriptionProps struct {
	RankingUUID string
	// Description is markdown as the owner typed it, not HTML.
	Description string
	Editable    bool
}

// RankingDescription is the reading state: rendered markdown that opens the
// editor when clicked. It is a div rather than a button because markdown
// produces paragraphs and lists, which a button may not contain.
templ RankingDescription(props RankingDescriptionProps) {
	if props.Editable {
		<div
			id="ranking-description"
			role="button"
			tabindex="0"
			aria-label="Edit description"
			title="Click to edit"
			class="markdown-body w-full cursor-text rounded-md px-1 py-0.5 text-sm text-text-muted hover:bg-surface-hover"
			hx-get={ fmt.Sprintf("/r/%s/description/edit", props.RankingUUID) }
			hx-trigger="click, keyup[key=='Enter']"
			hx-target="#ranking-description"
			hx-swap="outerHTML"
		>
			if props.Description != "" {
				@Markdown(props.Description)
			} else {
				<p class="text-subtle">What are you ranking?</p>
			}
		</div>
	} else {
		<div id="ranking-description" class="markdown-body w-full px-1 text-sm text-text-muted">
			if props.Description != "" {
				@Markdown(props.Description)
			}
		</div>
	}
}

// RankingDescriptionForm is the editing state. It is a plain div, not a
// <form>: on the board it is swapped in inside the form that owns the title,
// and a nested form is invalid HTML. Escape cancels through htmx's own
// trigger syntax, so the editor needs no script.
templ RankingDescriptionForm(props RankingDescriptionProps) {
	<div id="ranking-description" class="w-full space-y-1">
		<textarea
			id="ranking-description-input"
			name="description"
			rows="4"
			autofocus
			aria-label="Ranking description"
			placeholder="What are you ranking?"
			class="w-full rounded-md border border-border bg-surface px-2 py-1 text-sm outline-none focus:bg-surface-hover"
			hx-get={ fmt.Sprintf("/r/%s/description", props.RankingUUID) }
			hx-trigger="keyup[key=='Escape']"
			hx-target="#ranking-description"
			hx-swap="outerHTML"
		>{ props.Description }</textarea>
		<div class="flex items-center justify-end gap-2">
			<span class="mr-auto text-xs text-subtle">Markdown supported</span>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/r/%s/description", props.RankingUUID) }
				hx-target="#ranking-description"
				hx-swap="outerHTML"
				class="cursor-pointer rounded-md px-2 py-1 text-xs text-text-muted hover:bg-surface-hover hover:text-text-muted-hover"
			>
				Cancel
			</button>
			<button
				type="button"
				hx-post={ fmt.Sprintf("/r/%s/description", props.RankingUUID) }
				hx-include="#ranking-description-input"
				hx-target="#ranking-description"
				hx-swap="outerHTML"
				class="cursor-pointer rounded-md border border-border bg-secondary px-2 py-1 text-xs text-background hover:bg-secondary-hover"
			>
				Save
			</button>
		</div>
	</div>
}
