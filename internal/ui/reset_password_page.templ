package ui

// ResetPasswordProps configures ResetPasswordPage and its inner form. Token
// is the plaintext value from the query string; it rides through the form
// as a hidden field so a failed submission (e.g. a too-short password)
// doesn't need to re-parse it from the URL to re-render. Done flips the
// form to a confirmation notice once the password has actually been
// changed.
type ResetPasswordProps struct {
	CSRFToken string
	LoggedIn  bool
	Flash     string
	Token     string
	Error     string
	Done      bool
}

templ ResetPasswordPage(props ResetPasswordProps) {
	@Layout(LayoutProps{Title: "Reset password", CSRFToken: props.CSRFToken, LoggedIn: props.LoggedIn, Flash: props.Flash}) {
		<div class="mx-auto max-w-sm space-y-6">
			<h1 class="text-2xl font-bold tracking-tight">Choose a new password</h1>
			@ResetPasswordForm(props)
		</div>
	}
}

// ResetPasswordForm is also what POST /reset-password renders back as an
// htmx swap, so it carries its own id rather than relying on the page
// wrapper for one.
templ ResetPasswordForm(props ResetPasswordProps) {
	<div id="reset-password-form" class="space-y-4">
		if props.Done {
			@Notice(NoticeProps{Variant: NoticeSuccess}) {
				Password updated. <a href="/login" class="underline">Sign in</a> with your new password.
			}
		} else {
			<form hx-post="/reset-password" hx-target="#reset-password-form" hx-swap="outerHTML" class="space-y-4">
				<input type="hidden" name="token" value={ props.Token }/>
				if props.Error != "" {
					@Notice(NoticeProps{Variant: NoticeError}) {
						{ props.Error }
					}
				}
				@Input(InputProps{
					Name:     "password",
					Type:     "password",
					Label:    "New password",
					Required: true,
					Attrs:    templ.Attributes{"autocomplete": "new-password", "minlength": "8"},
				})
				@Button(ButtonProps{Type: "submit", Variant: ButtonPrimary}) {
					Update password
				}
			</form>
		}
	</div>
}
