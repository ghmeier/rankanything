package ui

// LandingPageProps configures LandingPage. CSRFToken rides on Layout's
// hx-headers like every other page; LoggedIn is always false in practice
// (handlers_public.go only renders this page for signed-out visitors) but
// is threaded through rather than hardcoded so Layout stays a single
// source of truth for the navbar.
type LandingPageProps struct {
	CSRFToken string
}

// demoTier is one row of the static S-F scaffold below the CTA. It reuses
// services.DefaultTiers' S/A/B/C/D palette (extended with an F row in the
// same family) so the demo doesn't introduce a color the real board
// doesn't already use.
type demoTier struct {
	Label string
	Color string
	Items []string
}

var demoTiers = []demoTier{
	{Label: "S", Color: "#f59e0b", Items: []string{"Teal"}},
	{Label: "A", Color: "#22c55e", Items: []string{"Blue", "Forest Green"}},
	{Label: "B", Color: "#3b82f6", Items: []string{"Purple"}},
	{Label: "C", Color: "#a855f7", Items: []string{"Yellow", "Orange"}},
	{Label: "D", Color: "#64748b", Items: []string{"Beige"}},
	{Label: "F", Color: "#94a3b8", Items: []string{"Neon Pink"}},
}

// LandingPage is the marketing page shown at "/" to signed-out visitors:
// hero, a CTA into signup, and a static (non-persisting, non-draggable)
// preview of the S-F tier board every new account starts with.
templ LandingPage(props LandingPageProps) {
	@Layout(LayoutProps{Title: "Rank Anything - free tier list maker", CSRFToken: props.CSRFToken, LoggedIn: false}) {
		<div class="space-y-16 py-8">
			<section class="mx-auto max-w-2xl space-y-6 text-center">
				<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
					Rank anything.
				</h1>
				<p class="text-lg text-text-muted">
					Drag your favorites into tiers and share the result — a tier
					list for movies, snacks, coworkers, or whatever you're arguing
					about tonight. Free, forever, no credit card.
				</p>
				<div>
					<a href="/register" class={ ButtonClass(ButtonPrimary) + " px-6 py-3 text-base" }>
						Create your first ranking
					</a>
				</div>
			</section>
			<section class="mx-auto max-w-3xl space-y-4">
				<div class="text-center">
					<h2 class="text-sm font-semibold tracking-wide text-text-muted uppercase">
						What you'll build
					</h2>
					<p class="mt-1 text-sm text-text-subtle">
						A preview of favorite colors, ranked S through F. Sign up and this
						becomes yours to edit and share.
					</p>
				</div>
				@demoBoard()
			</section>
		</div>
	}
}

// demoBoard renders the static S-F scaffold. It intentionally shares no
// markup with partials/tier_row.html: there is no session, no ranking row,
// and no drag behavior here, only a look-alike of the real board.
templ demoBoard() {
	<div
		class="overflow-hidden rounded-lg border border-border bg-surface"
		aria-label="Example tier list of favorite colors"
	>
		for _, tier := range demoTiers {
			<div class="flex items-stretch gap-2 border-b border-border last:border-b-0">
				<div
					class="flex w-20 shrink-0 items-center justify-center p-2 text-xl font-bold text-text"
					style={ "background-color: " + tier.Color }
				>
					{ tier.Label }
				</div>
				<div class="flex flex-1 flex-wrap content-center gap-2 p-3">
					for _, item := range tier.Items {
						<span class="rounded-md border border-border bg-surface-muted px-3 py-1.5 text-sm text-text">
							{ item }
						</span>
					}
				</div>
			</div>
		}
	</div>
}
