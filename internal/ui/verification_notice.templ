package ui

// ResendVerificationNotice swaps itself for the sent notice, so a slow mail
// provider never leaves the button silently doing nothing.
templ ResendVerificationNotice(email string) {
	<div id="verification-notice">
		@Notice(NoticeProps{Variant: NoticeError}) {
			<div class="flex flex-wrap w-full items-center justify-between gap-3">
				<span>Verify { email } to make sure you never lose access to your rankings.</span>
				@Button(ButtonProps{
					Variant: ButtonSecondary,
					Attrs: templ.Attributes{
						"hx-post":   "/resend-verification",
						"hx-target": "#verification-notice",
						"hx-swap":   "outerHTML",
					},
				}) {
					Resend verification email
				}
			</div>
		}
	</div>
}

// ResendVerificationSentNotice confirms the mail went out.
templ ResendVerificationSentNotice(email string) {
	<div id="verification-notice">
		@Notice(NoticeProps{Variant: NoticeSuccess, Dismissable: true, ID: "verification-sent"}) {
			Verification email sent to { email } — check your inbox.
		}
	</div>
}
