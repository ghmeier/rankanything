package ui

// NoticeVariant selects a Notice's tone.
type NoticeVariant string

const (
	NoticeSuccess NoticeVariant = "success"
	NoticeError   NoticeVariant = "error"
)

type NoticeProps struct {
	Variant     NoticeVariant
	Attrs       templ.Attributes
	ID          string
	Dismissable bool
}

templ Notice(props NoticeProps) {
	<div role="status" class={ noticeClass(props.Variant) } { props.Attrs... }>
		{ children... }
		if props.Dismissable {
			<input id={ "dismiss-" + props.ID } type="checkbox" class="sr-only"/>
			<label for={ "dismiss-" + props.ID } class="h-4 w-4 text-text-muted hover:text-text-muted-hover cursor-pointer inline-flex items-center justify-center">
				@CloseIcon()
			</label>
		}
	</div>
}

func noticeClass(variant NoticeVariant) string {
	const base = "rounded-md border px-4 py-2 text-sm flex flex-row justify-between items-center has-[:checked]:hidden"
	if variant == NoticeError {
		return base + " border-danger bg-danger-surface text-danger"
	}
	return base + " border-success bg-success-surface text-success"
}
