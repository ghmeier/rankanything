# Secrets must never reach the image; the host injects real environment
# variables instead.
.env
.env.*

.git
.github
node_modules
tmp

# Rebuilt inside the image by the css stage. Copying the local one in would
# let a stale desktop build silently become the deployed stylesheet.
assets/static/css/app.css

*.md
.config
scripts
db/queries
sqlc.yaml
.air.toml
